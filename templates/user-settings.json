{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/guard_bash.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/secret_scan.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/py_check.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}